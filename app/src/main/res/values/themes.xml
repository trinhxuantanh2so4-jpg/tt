<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================= THEME CHINH ================= -->
    <style name="Theme.TT" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Mau thuong hieu -->
        <item name="colorPrimary">@color/tt_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/tt_red_soft</item>
        <item name="colorOnPrimaryContainer">@color/tt_red</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/tt_black</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>

        <!-- Nen / chu -->
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/error</item>

        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/is_light_theme</item>
    </style>

    <!-- ================= SPLASH ================= -->
    <style name="Theme.TT.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tt_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TT</item>
    </style>

</resources>
